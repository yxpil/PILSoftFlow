[Unit]
Description=NodeSleepServer - 空闲自动关机守护(重型服务器端)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/node /opt/sleep-server/server.js start --config /etc/sleep-server/config.json
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
